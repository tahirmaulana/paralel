{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "../../packages/auth/src/**/*.ts",
    "../../packages/contracts/src/**/*.ts",
    "../../packages/db/src/**/*.ts",
    "../../packages/domain/src/**/*.ts",
    "../../packages/shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
