# ==========================================
# SMART CONTRACT (Foundry)
# Used when running: forge script
# ==========================================
## Platform Endpoints & Contract Addresses
ARBITRUM_RPC_URL="..."
USDC_ADDRESS="0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d"

## Private keys for Platform wallets
OWNER_PRIVATE_KEY="0x..." # For deployment and owner-only contract setup
# Use the deployed relayer wallet's key: exactly 64 hex characters, optionally prefixed with 0x.
# Never commit or share the actual private key.
RELAYER_PRIVATE_KEY=

## Platform wallet addresses
OWNER_PLATFORM_WALLET="0x..."
RELAYER_WALLET="0x..."
TAX_WALLET="0x..."

# ==========================================
# WEB FRONTEND & API RELAY (Next.js)
# Used in: apps/web/.env.local
# ==========================================

## Neon database connection string
PARALEL_TESTNET_DATABASE_NAME="" # Exact test DB name required by the guarded reset script; never use a production name.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

## Platform Endpoints & Contract Addresses
ARBITRUM_RPC_URL="..."
# Optional browser read endpoint. This URL is public; never put a private API key here.
# NEXT_PUBLIC_ARBITRUM_RPC_URL="https://..."
USDC_ADDRESS="0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d"
AUCTION_CONTRACT_ADDRESS="0xa0e47157cffb3385dc3bbed71174c8bb79028632"
POLICY_REGISTRY_ADDRESS="0x39a405127ED988BFa4A1aF05e312C41413029508"

## Private keys for Platform wallets
OWNER_PRIVATE_KEY="0x..." # For deployment and owner-only contract setup
# Use the deployed relayer wallet's key: exactly 64 hex characters, optionally prefixed with 0x.
# It must derive the same address as the contract's relayerWallet().
# Never commit or share the actual private key.
RELAYER_PRIVATE_KEY=

## Platform wallet addresses
OWNER_PLATFORM_WALLET="0x..."
RELAYER_WALLET="0x..."
USER_ADMIN_WALLET="0x..."

## Public Tax & Partners wallet addresses
TAX_WALLET="0x..."
NOTARY_WALLET="0x..., 0x..., 0x..."
GUARANTOR_WALLET="0x..., 0x..., 0x..."

# ==========================================
# NEON OBJECT STORAGE (S3-compatible)
# Used in: apps/web/.env.local
# ==========================================
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_ENDPOINT_URL_S3="..."
AWS_REGION="..."
S3_BUCKET="paralel-bucket" # Default bucket for all purposes. Each purpose can override with its own bucket name.   
# Optional per-purpose buckets. When omitted, each purpose uses S3_BUCKET with
# its corresponding prefix.
S3_BUCKET_AUCTIONS_ITEM_DOCUMENTS=""
S3_BUCKET_AUCTIONS_ITEM_PHOTOS=""
S3_BUCKET_PARTNERS_DOCUMENTS=""
S3_BUCKET_PARTNERS_PHOTOS=""
S3_BUCKET_USERS_KYC_PHOTOS=""

# ==========================================
# INDEXER (Cloudflare Worker)
# Used in: workers/indexer/.dev.vars, workers/keeper/.dev.vars
# ==========================================
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
ARBITRUM_RPC_URL="..."
AUCTION_CONTRACT_ADDRESS="0x4e1d0ae7c4df25276b3aa5d6392f01741084b7f8"